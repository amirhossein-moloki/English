# ChatGPT to Anki Bridge - Environment Configuration

# AnkiConnect Configuration
ANKI_CONNECT_URL=http://localhost:8765
ANKI_DEFAULT_DECK=English Vocabulary
ANKI_NOTE_TYPE=English Vocabulary

# Language & Locale Settings
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en-US

# Audio Provider Credentials (Optional / Configurable)
OXFORD_APP_ID=
OXFORD_APP_KEY=
MERRIAM_WEBSTER_API_KEY=

# Audio & Cache Preferences
AUDIO_PROVIDER_PRIORITY=oxford,merriam_webster,cambridge,tts
ENABLE_TTS_FALLBACK=true
TTS_PROVIDER=edge_tts
ALLOW_CARDS_WITHOUT_AUDIO=false
MAX_AUDIO_SIZE_BYTES=5242880
CACHE_DIR=./data/cache

# LLM Parser Preferences (Optional)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Duplicate Handling Policy: SKIP, UPDATE, or CREATE
DUPLICATE_POLICY=SKIP
